# =============================================================================
# Denboy VPN — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# For production, consider using a secrets manager instead.
#
# Generate secrets:
#   AI_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SESSION_SECRET:    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   Database password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# =============================================================================

# ---------------------------- Node Runtime ----------------------------

NODE_ENV=development
HOSTNAME=127.0.0.1
PORT=3000

# ---------------------------- Database (PostgreSQL) ----------------------------

# Connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://mvmp:CHANGE_ME@127.0.0.1:5432/mvmp?schema=public

# ---------------------------- Redis ----------------------------

# Redis connection string
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# ---------------------------- Encryption (REQUIRED in production) ----------------------------

# 32-byte AES-256-GCM key, hex-encoded (64 characters)
# Used to encrypt sensitive data at rest (API keys, credentials)
# If missing in production, the application will refuse to start
AI_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ---------------------------- Session Security ----------------------------

# Secret for signing session cookies (reserved for future use)
SESSION_SECRET=CHANGE_ME_96_HEX_CHARS

# Session cookie name
SESSION_COOKIE=mvmp_session

# Session TTL in hours
SESSION_TTL_HOURS=24

# ---------------------------- Public URL ----------------------------

# Base URL of your application (used for absolute URLs, email links, OAuth callbacks)
PUBLIC_URL=https://your-domain.com

# ---------------------------- Realtime Service ----------------------------

# Socket.IO port for realtime connections
REALTIME_SOCKET_PORT=3003

# HTTP emit port for server-to-server communication
REALTIME_EMIT_PORT=3004

# ---------------------------- AI Configuration (optional) ----------------------------

# Emergency shutdown switch for AI features
AI_EMERGENCY_SHUTDOWN=false

# Enable/disable AI chatbot
AI_CHATBOT_ENABLED=true

# Token limits
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000

# Fallback to mock responses when AI provider is unavailable
AI_FALLBACK_TO_MOCK=false

# ---------------------------- Rate Limiting ----------------------------

RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AI_AGENT_PER_MIN=10
RATE_LIMIT_AI_SUGGEST_PER_MIN=5
RATE_LIMIT_PROVIDER_TEST_PER_MIN=3

# ---------------------------- Resource Profile ----------------------------

# Resource profile: small (4CPU/4GB), medium (8CPU/8GB), large (16CPU/16GB)
MVMP_PROFILE=small
MVMP_API_MEMORY=1G
MVMP_WORKER_MEMORY=512M
MVMP_REALTIME_MEMORY=256M
MVMP_POSTGRES_MEMORY=1G
MVMP_REDIS_MEMORY=256M

# ---------------------------- Logging ----------------------------

LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=90

# ---------------------------- Backup ----------------------------

BACKUP_DIR=/var/backups/mvmp
BACKUP_RETENTION_DAYS=30

# ---------------------------- Email (SMTP) ----------------------------

# SMTP server configuration for sending emails
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Denboy VPN <noreply@your-domain.com>"

# ---------------------------- Payment Gateway (optional) ----------------------------

# Configure payment gateways via the admin UI.
# These environment variables are fallback defaults only.
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# IPAYMU_API_KEY=
# IPAYMU_VIRTUAL_ACCOUNT=

# ---------------------------- WhatsApp Integration (optional) ----------------------------

# Configure WhatsApp via the admin UI.
# These environment variables are fallback defaults only.
# WA_PROVIDER=wablas
# WABLAS_TOKEN=
# WAQID_TOKEN=

# ---------------------------- Telegram Bot (optional) ----------------------------

# Configure Telegram bot via the admin UI.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
