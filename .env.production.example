# MVMP — Production environment example
#
# Copy to /etc/mvmp/app.env (root-readable only — chmod 600, chown root:mvmp).
# Edit values for your deployment.
#
# NEVER commit real secrets to git. This file contains only placeholders.
#
# Generate secrets:
#   AI_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   SESSION_SECRET:    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Node runtime ----
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

# ---- Database (PostgreSQL) ----
# Set by /etc/mvmp/db.env — DO NOT duplicate here.
# DATABASE_URL=postgresql://mvmp:<password>@127.0.0.1:5432/mvmp?schema=public

# ---- Redis ----
# Set by /etc/mvmp/redis.env — DO NOT duplicate here.
# REDIS_URL=redis://:<password>@127.0.0.1:6379

# ---- Encryption (REQUIRED in production) ----
# 32-byte AES-256-GCM key, hex-encoded (64 chars).
# Used to encrypt AI provider API keys at rest (AICredential.keyEncrypted).
# If missing in production, the application REFUSES to start.
AI_ENCRYPTION_KEY=<generate-with-node-crypto-randomBytes-32-hex>

# ---- Session security ----
# Cookie-based session ID is currently stored in the Session table (no signing).
# SESSION_SECRET is reserved for future signed-cookie support. Set it now so
# future upgrades do not invalidate sessions.
SESSION_SECRET=<generate-with-node-crypto-randomBytes-48-hex>
SESSION_COOKIE=mvmp_session
SESSION_TTL_HOURS=24

# ---- Public URL (used for absolute URLs in emails, OAuth callbacks, etc.) ----
PUBLIC_URL=https://mvmp.example.com

# ---- Realtime service ----
REALTIME_SOCKET_PORT=3003
REALTIME_EMIT_PORT=3004

# ---- AI providers (optional — configure per-provider via AI Center UI) ----
# Keys are stored encrypted in the database, NOT in env.
# These env vars are only used for boot-time defaults if the DB has no config.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- AI safety defaults ----
AI_EMERGENCY_SHUTDOWN=false
AI_CHATBOT_ENABLED=true
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_FALLBACK_TO_MOCK=false

# ---- Rate limiting (Redis-backed in production) ----
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AI_AGENT_PER_MIN=10
RATE_LIMIT_AI_SUGGEST_PER_MIN=5
RATE_LIMIT_PROVIDER_TEST_PER_MIN=3

# ---- Payments (configure via Settings UI; env is fallback only) ----
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# IPAYMU_API_KEY=
# IPAYMU_VIRTUAL_ACCOUNT=

# ---- WhatsApp (configure via WhatsApp Integration UI; env is fallback only) ----
# WA_PROVIDER=wablas
# WABLAS_TOKEN=
# WAQID_TOKEN=

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@mvmp.example.com
SMTP_PASSWORD=<set-or-leave-blank-for-disabled>
SMTP_FROM="MVMP <noreply@mvmp.example.com>"

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Audit log retention (days) ----
AUDIT_LOG_RETENTION_DAYS=90

# ---- Backup (used by scripts/deploy/backup.sh) ----
BACKUP_DIR=/var/backups/mvmp
BACKUP_RETENTION_DAYS=30
