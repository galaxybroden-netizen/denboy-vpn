# MVMP — Docker Compose environment file
#
# Copy to .env in the repo root (same dir as docker-compose.yml) and edit:
#   cp deploy/docker/docker-compose.env.example .env
#   nano .env
#
# docker compose automatically reads .env in the project directory.

# ===== Database (PostgreSQL) =====
MVMP_DB_NAME=mvmp
MVMP_DB_USER=mvmp
# Generate strong password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MVMP_DB_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHARS

# ===== Redis =====
# Generate strong password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
MVMP_REDIS_PASSWORD=CHANGE_ME_TO_RANDOM_32_CHARS

# ===== AI Encryption (REQUIRED) =====
# 32-byte AES-256-GCM key, hex-encoded (64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=GENERATE_WITH_node_crypto_randomBytes_32_hex

# ===== Session =====
SESSION_SECRET=GENERATE_WITH_node_crypto_randomBytes_48_hex

# ===== Public URL =====
PUBLIC_URL=https://mvmp.example.com

# ===== AI defaults =====
AI_CHATBOT_ENABLED=true
AI_EMERGENCY_SHUTDOWN=false

# ===== Rate limits =====
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AI_AGENT_PER_MIN=10

# ===== Resource profile (Phase 14 TASK 7) =====
# Default: 'small' fits 4 CPU / 4 GB RAM host
MVMP_PROFILE=small
MVMP_API_MEMORY=1G
MVMP_WORKER_MEMORY=512M
MVMP_REALTIME_MEMORY=256M
MVMP_POSTGRES_MEMORY=1G
MVMP_REDIS_MEMORY=256M

# ===== Logging =====
LOG_LEVEL=info
LOG_FORMAT=json
