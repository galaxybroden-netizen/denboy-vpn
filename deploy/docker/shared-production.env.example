# MVMP — Shared production environment (used by both Docker and Native deployments)
#
# This file is the SINGLE SOURCE OF TRUTH for production env var names.
# Both Docker (deploy/docker/docker-compose.env.example) and Native
# (.env.production.example) inherit these names. Do NOT rename without
# updating both delivery paths.
#
# Delivery:
#   Native (Phase 13):  /etc/mvmp/{db.env, redis.env, app.env}  (root-only files)
#   Docker (Phase 14):  .env file loaded by docker compose, or Docker secrets
#
# All values below are PLACEHOLDERS. Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===== Runtime =====
NODE_ENV=production
HOSTNAME=0.0.0.0              # Docker: bind all interfaces inside container; Native: 127.0.0.1
PORT=3000

# ===== Database (PostgreSQL) =====
# Both Docker and Native use PostgreSQL in production.
# Native: postgresql://mvmp:<pw>@127.0.0.1:5432/mvmp?schema=public
# Docker:  postgresql://mvmp:<pw>@postgres:5432/mvmp?schema=public  (service name on internal network)
DATABASE_URL=postgresql://mvmp:CHANGE_ME@127.0.0.1:5432/mvmp?schema=public

# ===== Redis =====
# Native: redis://:<pw>@127.0.0.1:6379
# Docker:  redis://:<pw>@redis:6379  (service name on internal network)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# ===== Encryption (REQUIRED in production) =====
# 32-byte AES-256-GCM key, hex-encoded (64 chars).
# Used by src/lib/crypto.ts to encrypt AI provider API keys at rest.
# If missing in production, src/instrumentation.ts exits with status 1.
AI_ENCRYPTION_KEY=GENERATE_WITH_node_crypto_randomBytes_32_hex

# ===== Session =====
# Currently cookie session ID stored in Session table (no signing).
# SESSION_SECRET reserved for future signed-cookie support.
SESSION_SECRET=GENERATE_WITH_node_crypto_randomBytes_48_hex
SESSION_COOKIE=mvmp_session
SESSION_TTL_HOURS=24

# ===== Public URL =====
PUBLIC_URL=https://mvmp.example.com

# ===== Realtime service =====
REALTIME_SOCKET_PORT=3003
REALTIME_EMIT_PORT=3004

# ===== AI defaults =====
AI_EMERGENCY_SHUTDOWN=false
AI_CHATBOT_ENABLED=true
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_FALLBACK_TO_MOCK=false

# ===== Rate limiting (Redis-backed in production) =====
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_AI_AGENT_PER_MIN=10
RATE_LIMIT_AI_SUGGEST_PER_MIN=5
RATE_LIMIT_PROVIDER_TEST_PER_MIN=3

# ===== Resource profile (used by Docker compose deploy.replicas/resources) =====
# Defaults target: 4 CPU / 4 GB RAM host (Phase 14 TASK 7).
# Override per deployment as needed.
MVMP_PROFILE=small               # small (4cpu/4gb) | medium (8cpu/8gb) | large (16cpu/16gb)
MVMP_API_MEMORY=1G
MVMP_WORKER_MEMORY=512M
MVMP_REALTIME_MEMORY=256M
MVMP_POSTGRES_MEMORY=1G
MVMP_REDIS_MEMORY=256M

# ===== Backup =====
BACKUP_DIR=/var/backups/mvmp         # Native default
                                    # Docker uses /var/backups/mvmp-docker
BACKUP_RETENTION_DAYS=30

# ===== Logging =====
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=90

# ===== SMTP (optional) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@mvmp.example.com
SMTP_PASSWORD=
SMTP_FROM="MVMP <noreply@mvmp.example.com>"
