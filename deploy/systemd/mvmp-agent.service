[Unit]
Description=MVMP — Go agent (NOT USED in current repository)
Documentation=file:///opt/mvmp/docs/deployment/NATIVE_UBUNTU_INSTALLATION.md

# This unit is intentionally NOT installed by setup-systemd.sh because
# MVMP currently has no Go agent (no go.mod in repo).
#
# If a Go agent is added in the future:
#   1. Build it via scripts/deploy/build.sh (auto-detected via go.mod)
#   2. Copy this file to /etc/systemd/system/mvmp-agent.service
#   3. Edit ExecStart below to point to the built binary
#   4. systemctl daemon-reload && systemctl enable --now mvmp-agent

[Service]
Type=simple
User=mvmp
Group=mvmp
WorkingDirectory=/opt/mvmp
EnvironmentFile=/etc/mvmp/db.env
EnvironmentFile=/etc/mvmp/redis.env
EnvironmentFile=/etc/mvmp/app.env

ExecStart=/opt/mvmp/.next/standalone/mvmp-agent

KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s

MemoryHigh=128M
MemoryMax=256M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mvmp /var/log/mvmp /var/run/mvmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mvmp-agent

[Install]
WantedBy=multi-user.target
