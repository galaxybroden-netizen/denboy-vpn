// ============ WHATSAPP MODULE (SaaS-grade) ============
// Tracks integration config (3 providers), synced contacts, conversations,
// messages, templates, broadcasts, and quick replies.

model WhatsappIntegration {
  id              String   @id @default(cuid())
  // Provider: "meta_cloud" (official WA Business API), "baileys" (unofficial WA Web via QR),
  // or "api" (generic third-party like Fonnte/Wapanels)
  provider        String   @default("baileys")
  // Status: "disconnected" | "connecting" | "connected" | "error"
  status          String   @default("disconnected")
  // Phone number of the connected WA account (JID format like 62xxx@s.whatsapp.net for Baileys)
  phoneNumber     String?
  displayName     String?
  // Credentials (encrypted at rest in production; plaintext OK for MVP sandbox)
  // - Meta Cloud: { wabaId, phoneNumberId, accessToken, appId }
  // - Baileys: { sessionId, qrCodeData, sessionCredsPath }
  // - API: { apiUrl, apiKey, senderNumber }
  credentialsJson String?
  // Last QR code data URI (for Baileys pairing) — cleared after pairing succeeds
  qrCodeData      String?
  lastConnectedAt DateTime?
  lastError       String?
  // Auto-reply rules: array of { keyword, response, isActive }
  autoReplyRulesJson String?
  // Default settings
  defaultTemplateId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WhatsappContact {
  id          String   @id @default(cuid())
  // Normalized phone number (E.164 without +, e.g. 6281234567890)
  phoneNumber String   @unique
  displayName String
  avatarUrl   String?
  // Source: "CUSTOMER" (synced from Customer table), "USER" (admin/reseller), "MANUAL"
  source      String   @default("MANUAL")
  sourceId    String?  // customer.id or user.id
  tags        String?  // JSON array of strings
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations WhatsappConversation[]
  broadcastRecipients WhatsappBroadcastRecipient[]
}

model WhatsappConversation {
  id            String   @id @default(cuid())
  contactId     String
  // Assignee: which admin/user is handling this conversation
  assigneeId    String?
  status        String   @default("OPEN")  // OPEN | PENDING | RESOLVED | SPAM
  unreadCount   Int      @default(0)
  lastMessageAt DateTime?
  lastMessagePreview String?  // truncated last message body
  lastMessageDirection String? // "IN" or "OUT"
  // Tags for categorization (e.g. "billing", "support", "sales")
  tagsJson      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact       WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee      User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      WhatsappMessage[]

  @@index([status])
  @@index([assigneeId])
}

model WhatsappMessage {
  id              String   @id @default(cuid())
  conversationId  String
  // IN = received from customer, OUT = sent by us
  direction       String
  // TEXT, IMAGE, DOCUMENT, TEMPLATE, AUDIO, VIDEO
  type            String   @default("TEXT")
  body            String
  // Media URL (if type != TEXT)
  mediaUrl        String?
  // Status for OUT messages: PENDING | SENT | DELIVERED | READ | FAILED
  // For IN messages: RECEIVED
  status          String   @default("PENDING")
  // If sent via template, link to template
  templateId      String?
  // Metadata: error message, provider message ID, etc.
  metadataJson    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  conversation    WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

model WhatsappTemplate {
  id          String   @id @default(cuid())
  // Unique key for programmatic use (e.g. "payment_success", "expiry_warning")
  key         String   @unique
  name        String
  // Category: PAYMENT_SUCCESS, PAYMENT_REMINDER, MAINTENANCE, PURCHASE_CONFIRMATION,
  // EXPIRY_WARNING, OTP, WELCOME, CUSTOM
  category    String
  language    String   @default("id")
  // Body with variables: {{customer_name}}, {{invoice_number}}, {{amount}},
  // {{login_link}}, {{username}}, {{password}}, {{expires_at}}, {{server_name}}
  body        String
  // List of variable names used (auto-extracted, JSON array)
  variablesJson String?
  // DRAFT (internal) | APPROVED (ready to use, also submitted to Meta for Cloud API approval)
  status      String   @default("APPROVED")
  // For Meta Cloud API: the template ID returned by Meta after approval
  metaTemplateId String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  broadcasts  WhatsappBroadcast[]
}

model WhatsappBroadcast {
  id            String   @id @default(cuid())
  name          String
  templateId    String
  // Audience filter: JSON like { tags: ["vip"], customerStatus: "ACTIVE", hasUnpaidTx: true }
  audienceFilterJson String?
  // Computed audience count (cached at send time)
  audienceCount Int      @default(0)
  // Custom variables override (JSON) for this broadcast
  variablesJson String?
  status        String   @default("DRAFT")  // DRAFT | QUEUED | SENDING | COMPLETED | FAILED | SCHEDULED
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  // Stats: { sent: N, delivered: N, read: N, failed: N, replied: N }
  statsJson     String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  template      WhatsappTemplate @relation(fields: [templateId], references: [id])
  recipients    WhatsappBroadcastRecipient[]
}

model WhatsappBroadcastRecipient {
  id            String   @id @default(cuid())
  broadcastId   String
  contactId     String
  // Per-recipient status: QUEUED | SENT | DELIVERED | READ | FAILED
  status        String   @default("QUEUED")
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())

  broadcast     WhatsappBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact       WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([status])
}

model WhatsappQuickReply {
  id          String   @id @default(cuid())
  keyword     String   @unique
  response    String
  // Optional: trigger automatically when customer sends message containing keyword
  autoTrigger Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ TELEGRAM INTEGRATION (Phase 15 FASE 5) ============
model TelegramIntegration {
  id              String   @id @default(cuid())
  // Bot credentials (encrypted at rest via src/lib/crypto.ts)
  botTokenEncrypted String?  // AES-256-GCM encrypted bot token
  botTokenPrefix   String?  // first 4 + "••••" + last 4 for display
  botName          String?  // display name (from getMe)
  botUsername      String?  // @username (from getMe)
  // Webhook config
  webhookUrl       String?  // public URL for Telegram to send updates to
  webhookSecret    String?  // secret token for webhook validation
  // Connection status
  isActive         Boolean  @default(false)
  status           String   @default("disconnected") // "disconnected" | "connected" | "error"
  lastConnectedAt  DateTime?
  lastError        String?
  lastActivity     DateTime?
  // Default AI config for incoming Telegram messages
  defaultAgentId   String?
  defaultModelId   String?
  defaultKbId      String?
  // Access control — JSON array of Telegram user IDs allowed to use the bot
  // Empty array = allow all; non-empty = whitelist only
  allowedUserIds   String?  // JSON: ["123456789", "987654321"]
  // Metadata
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
